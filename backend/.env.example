# Copy this file to .env and fill in your values before running the backend.
# Never commit .env to version control.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/student_registration_portal
JWT_SECRET_KEY=change-this-secret-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=uploads
